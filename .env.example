DISCORD_TOKEN=put the discord token in here without quotations marks

# 42 API credentials (get from https://profile.intra.42.fr/oauth/applications)
API_42_UID=your_42_api_uid_here
API_42_SECRET=your_42_api_secret_here

# OAuth callback URL (must match what's registered in your 42 API app)
OAUTH_REDIRECT_URI=https://etaquet.fr/42/callback

# Server URL for OAuth coordination (the bot polls this for completed links)
OAUTH_SERVER_URL=http://127.0.0.1:8001
